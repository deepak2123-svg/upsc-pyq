{
  "name": "upscpuraan",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/build-reviewed-question-aliases.mjs --check && node scripts/build-prelims-reproduction-overrides.mjs --check && node scripts/build-reviewed-material-source-repairs.mjs --check && vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/answer-key-audit.test.mjs tests/reviewed-grading.test.mjs tests/question-placements.test.mjs tests/prelims-taxonomy-runtime.test.mjs tests/practice-draft-membership.test.mjs tests/rendered-html.test.mjs tests/taxonomy.test.mjs tests/indian-geography-taxonomy.test.mjs tests/geography-figure-audit.test.mjs tests/practice-selection.test.mjs tests/practice-api.test.mjs tests/practice-session.test.mjs tests/practice-prompt.test.mjs tests/nda-2026-ii-import.test.mjs tests/nda-2026-i-import.test.mjs tests/preparation-exams.test.mjs",
    "test:preparation": "node --test tests/preparation-exams.test.mjs",
    "test:browser": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vercel",
    "db:generate": "drizzle-kit generate",
    "content:normalize": "node scripts/normalize-question-banks.mjs",
    "content:review-policy": "node scripts/sync-question-review-policy.mjs",
    "content:review-reconstructions": "node scripts/apply-approved-question-reconstructions.mjs && node scripts/sync-question-review-policy.mjs && node scripts/audit-all-answer-keys.mjs",
    "content:taxonomy": "node scripts/backfill-question-taxonomy.mjs",
    "content:prelims-syllabus": "node scripts/build-prelims-syllabus.mjs",
    "content:check-prelims-syllabus": "node scripts/build-prelims-syllabus.mjs --check",
    "content:prelims-review-state": "node scripts/build-prelims-reviewed-placements.mjs && node scripts/reconcile-prelims-classification.mjs && node scripts/build-reviewed-question-aliases.mjs && node scripts/build-prelims-reproduction-overrides.mjs && node scripts/build-reviewed-material-source-repairs.mjs",
    "content:audit-indian-geography": "node scripts/audit-indian-geography-answers.mjs",
    "content:draft-indian-geography-import": "node scripts/build-indian-geography-import-draft.mjs",
    "content:audit-indian-geography-pdfs": "node scripts/audit-indian-geography-original-pdfs.mjs",
    "content:audit-geography-figures": "node scripts/audit-geography-question-figures.mjs",
    "content:import": "node scripts/import-questions-to-supabase.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@types/d3-sankey": "^0.12.5",
    "d3-sankey": "^0.12.3",
    "drizzle-orm": "0.45.2",
    "idb": "^8.0.3",
    "motion": "^13.1.0",
    "next": "16.2.6",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@jridgewell/sourcemap-codec": "^1.5.4",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "csstype": "^3.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "magic-string": "^0.30.19",
    "nitro": "^3.0.260610-beta",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
